<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si el archivo o directorio solicitado existe físicamente, servirlo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rutas limpias sin extensión .html
    RewriteRule ^catalogo/?$ catalogo.html [L]
    RewriteRule ^diseno-grafico/?$ diseno-grafico.html [L]
    RewriteRule ^desarrollo-web/?$ desarrollo-web.html [L]

    # Redirección de la raíz a index.html
    RewriteRule ^$ index.html [L]
</IfModule>

# Forzar compresión GZIP y tipos MIME
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
